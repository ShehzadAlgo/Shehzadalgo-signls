{
  "entities": {
    "RiskConfig": {
      "title": "RiskConfig",
      "description": "User risk management parameters and kill-switch configuration for Meridian.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase UID" },
        "accountBalanceUsd": { "type": "number", "description": "Reference paper/follower account balance in USD" },
        "riskPerTradePct": { "type": "number", "description": "Risk percentage per trade (0.25 to 1.0 default)" },
        "maxOpenRiskPct": { "type": "number", "description": "Maximum simultaneous open portfolio risk %" },
        "maxClusterRiskPct": { "type": "number", "description": "Maximum net currency or crypto beta cluster risk %" },
        "maxOpenPerInstrument": { "type": "integer", "description": "Maximum concurrent open signals per instrument" },
        "dailyLossLimitPct": { "type": "number", "description": "Daily loss circuit breaker %" },
        "weeklyLossLimitPct": { "type": "number", "description": "Weekly loss circuit breaker %" },
        "drawdownHalvePct": { "type": "number", "description": "Drawdown threshold to halve position sizing" },
        "drawdownHaltPct": { "type": "number", "description": "Drawdown threshold to halt new signals" },
        "maxCostToStopRatio": { "type": "number", "description": "Maximum allowed estimated cost relative to stop distance" },
        "minLiquidationStops": { "type": "integer", "description": "Minimum stop-distance multiplier to liquidation price" },
        "newsBlackoutBeforeMin": { "type": "integer", "description": "Minutes before high-impact event to block entries" },
        "newsBlackoutAfterMin": { "type": "integer", "description": "Minutes after high-impact event to block entries" },
        "feedMaxLagSeconds": { "type": "integer", "description": "Maximum allowed market feed lag before safety halt" },
        "manualKillSwitch": { "type": "boolean", "description": "Manual admin/user kill switch state" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": [
        "userId",
        "accountBalanceUsd",
        "riskPerTradePct",
        "maxOpenRiskPct",
        "maxClusterRiskPct",
        "maxOpenPerInstrument",
        "dailyLossLimitPct",
        "weeklyLossLimitPct",
        "drawdownHalvePct",
        "drawdownHaltPct",
        "maxCostToStopRatio",
        "minLiquidationStops",
        "newsBlackoutBeforeMin",
        "newsBlackoutAfterMin",
        "feedMaxLagSeconds",
        "manualKillSwitch",
        "createdAt",
        "updatedAt"
      ]
    },
    "SignalRecord": {
      "title": "SignalRecord",
      "description": "Immutable-parameter trade signal with tracked lifecycle outcome in R.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "signalUuid": { "type": "string" },
        "createdAtIso": { "type": "string" },
        "instrument": { "type": "string" },
        "assetClass": { "type": "string", "enum": ["fx", "crypto"] },
        "direction": { "type": "string", "enum": ["long", "short"] },
        "strategy": { "type": "string" },
        "strategyVersion": { "type": "string" },
        "configHash": { "type": "string" },
        "timeframe": { "type": "string" },
        "regime": { "type": "string" },
        "conviction": { "type": "number" },
        "entryType": { "type": "string" },
        "entryLow": { "type": "number" },
        "entryHigh": { "type": "number" },
        "stopLoss": { "type": "number" },
        "tp1Price": { "type": "number" },
        "tp1R": { "type": "number" },
        "tp1ClosePct": { "type": "integer" },
        "tp2Price": { "type": "number" },
        "tp2R": { "type": "number" },
        "tp2ClosePct": { "type": "integer" },
        "suggestedRiskPct": { "type": "number" },
        "estCostR": { "type": "number" },
        "expiresAtIso": { "type": "string" },
        "invalidation": { "type": "string" },
        "rationale": { "type": "string" },
        "riskStatus": { "type": "string", "enum": ["APPROVED", "REDUCED", "REJECTED"] },
        "riskAdjustments": { "type": "array" },
        "riskReasons": { "type": "array" },
        "idempotencyKey": { "type": "string" },
        "executionMode": { "type": "string", "enum": ["PAPER", "LIVE"] },
        "status": { "type": "string", "enum": ["PENDING", "TRIGGERED", "TP1_HIT", "WIN", "LOSS", "BREAKEVEN", "EXPIRED", "CANCELLED"] },
        "realizedR": { "type": "number" },
        "maeR": { "type": "number" },
        "mfeR": { "type": "number" },
        "durationMinutes": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "signalUuid",
        "createdAtIso",
        "instrument",
        "assetClass",
        "direction",
        "strategy",
        "strategyVersion",
        "configHash",
        "timeframe",
        "regime",
        "conviction",
        "entryType",
        "entryLow",
        "entryHigh",
        "stopLoss",
        "tp1Price",
        "tp1R",
        "tp1ClosePct",
        "tp2Price",
        "tp2R",
        "tp2ClosePct",
        "suggestedRiskPct",
        "estCostR",
        "expiresAtIso",
        "invalidation",
        "rationale",
        "riskStatus",
        "riskAdjustments",
        "riskReasons",
        "idempotencyKey",
        "executionMode",
        "status",
        "realizedR",
        "maeR",
        "mfeR",
        "durationMinutes",
        "createdAt",
        "updatedAt"
      ]
    },
    "SignalEventRecord": {
      "title": "SignalEventRecord",
      "description": "Append-only SHA-256 hash-chained ledger event.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "signalId": { "type": "string" },
        "sequenceIndex": { "type": "integer" },
        "eventType": { "type": "string" },
        "timestampIso": { "type": "string" },
        "payloadSummary": { "type": "string" },
        "prevHash": { "type": "string" },
        "eventHash": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "signalId",
        "sequenceIndex",
        "eventType",
        "timestampIso",
        "payloadSummary",
        "prevHash",
        "eventHash",
        "createdAt"
      ]
    },
    "ValidationReportRecord": {
      "title": "ValidationReportRecord",
      "description": "Stored out-of-sample strategy validation and Monte Carlo report.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "strategyId": { "type": "string" },
        "strategyVersion": { "type": "string" },
        "configHash": { "type": "string" },
        "dataSnapshotId": { "type": "string" },
        "randomSeed": { "type": "integer" },
        "lifecycleStatus": { "type": "string", "enum": ["DRAFT", "BACKTESTED", "PAPER", "LIVE", "SUSPENDED", "REJECTED"] },
        "trialCount": { "type": "integer" },
        "oosTrades": { "type": "integer" },
        "netExpectancyR": { "type": "number" },
        "profitFactor": { "type": "number" },
        "sharpe": { "type": "number" },
        "deflatedSharpe": { "type": "number" },
        "pbo": { "type": "number" },
        "mc95DrawdownPct": { "type": "number" },
        "ruinProbPct": { "type": "number" },
        "positiveYearsPct": { "type": "number" },
        "causalityPassed": { "type": "boolean" },
        "beatRandom95th": { "type": "boolean" },
        "failureReasons": { "type": "array" },
        "equityCurveR": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "strategyId",
        "strategyVersion",
        "configHash",
        "dataSnapshotId",
        "randomSeed",
        "lifecycleStatus",
        "trialCount",
        "oosTrades",
        "netExpectancyR",
        "profitFactor",
        "sharpe",
        "deflatedSharpe",
        "pbo",
        "mc95DrawdownPct",
        "ruinProbPct",
        "positiveYearsPct",
        "causalityPassed",
        "beatRandom95th",
        "failureReasons",
        "equityCurveR",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/risk_config/{configId}": {
      "schema": { "$ref": "#/entities/RiskConfig" },
      "description": "User-scoped risk engine parameters and kill-switch state."
    },
    "/users/{userId}/signals/{signalId}": {
      "schema": { "$ref": "#/entities/SignalRecord" },
      "description": "User-scoped published and paper-tracked trade signals."
    },
    "/users/{userId}/signal_events/{eventId}": {
      "schema": { "$ref": "#/entities/SignalEventRecord" },
      "description": "Append-only SHA-256 hash-chained event ledger for verifiable track records."
    },
    "/users/{userId}/strategy_reports/{reportId}": {
      "schema": { "$ref": "#/entities/ValidationReportRecord" },
      "description": "User-scoped strategy validation and Monte Carlo reports."
    }
  }
}
